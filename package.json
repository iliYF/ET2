{
  "name": "cf-edt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && wrangler deploy --dry-run  && cp wrangler.jsonc dist/",
    "deploy": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name et2-xhub",
    "dev": "WRANGLER_LOCAL=true wrangler dev",
    "dev:pages": "WRANGLER_LOCAL=true wrangler pages dev dist",
    "start": "WRANGLER_LOCAL=true wrangler dev",
    "test": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "vitest": "~3.2.0",
    "wrangler": "^4.114.0",
    "esbuild": "^0.25.0",
    "magic-string": "^0.30.0"
  }
}
